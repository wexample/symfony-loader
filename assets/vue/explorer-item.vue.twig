<div class="develop-explorer-item" :class="selected ? 'develop-explorer-item--selected' : ''">
    <div class="develop-explorer-item__label" v-on:click.prevent="select()">
        <div class="develop-explorer-item__indent" v-for="index in increment">&nbsp;&nbsp;&nbsp;&nbsp;</div>
        <i class="develop-explorer-item__icon icon" :class="renderItemIcon()"></i>
        <div class="develop-explorer-item__name" :title="getItemName()">
            {{ 'getItemName()' | vue_key }}
        </div>
    </div>
    <div class="develop-explorer-item__children">
        <explorer-item
                :increment="this.increment + 1"
                :object="children.object"
                :root="this.root"
                :type="children.type"
                :updateTime="updateTime"
                v-for="children in getChildren()"
        ></explorer-item>
    </div>
</div>
