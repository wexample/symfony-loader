{% block component %}
<div class="develop-routes">
    <div class="develop-routes__header">
        <input
            class="develop-routes__search"
            type="text"
            v-model="search"
            placeholder="Filter routes..."
        />
        <span class="develop-routes__count">{{ 'filteredRoutes.length' | vue_key }} / {{ 'allRoutes.length' | vue_key }}</span>
    </div>
    <div class="develop-routes__list">
        <div
            v-for="route in filteredRoutes"
            :key="route.name"
            class="develop-routes__item"
        >
            <span class="develop-routes__name">{{ 'route.name' | vue_key }}</span>
            <span class="develop-routes__path">{{ 'route.path' | vue_key }}</span>
        </div>
    </div>
</div>
{% endblock %}
