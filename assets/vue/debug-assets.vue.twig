{% block vue_require %}
    {{- vue_require(render_pass, '@WexampleSymfonyLoaderBundle/vue/debug-assets-explorer-item') -}}
{% endblock %}

{% block component %}
    <div class="develop-assets">
        <div class="develop-assets__explorer">
            <explorer-item
                    :increment="0"
                    :object="app.layout"
                    :root="this"
                    :update-time="updateTime"
                    type="layout"
            />
        </div>
        <div class="develop-assets__details">
            <table class="develop-assets__table">
                <tbody>
                    <tr v-for="asset in allAssets" :class="buildCssAsset(asset)">
                        <td class="asset-activation">
                            <div class="asset-activation__dot"></div>
                        </td>
                        <td class="asset-type" :class="`asset-type-${asset.type}`">
                            {{ 'asset.type' | vue_key }}
                        </td>
                        <td class="asset-responsive" v-html="asset.responsive || '·'"></td>
                        <td class="asset-initial">
                            <span v-if="asset.initialLayout" title="Initial layout">{{ icon('ph:bold/house-simple') }}</span>
                        </td>
                        <td class="asset-path" v-on:click="assetLog(asset)" :title="shortenAssetPath(asset)">
                            {{ 'shortenAssetPath(asset)' | vue_key }}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
