{%- extends '@WexampleSymfonyLoaderBundle/bases/json/default.html.twig' -%}

{%- block layout_composer_json -%}
    {%- set content -%}
        {{ parent() }}
    {%- endset -%}
    {%- block layout_composer_modal -%}
        {{ content }}
    {%- endblock -%}
{%- endblock -%}

{%- block page_composer_json -%}
    <div class="modal-header">
        {% set page_title = page_title | default('@page::page_title' | trans) %}
        {% if page_title | default(false) %}
            <h2 class="header-title">{{ page_title | trans }}</h2>
        {% else %}
            <div class="header-title"></div>
        {% endif %}
        {% if overlay_show_external_link is not defined or overlay_show_external_link != false %}
            <div class="modal-external-link">
                <a class="action-icon" href="{{ app.request.uri }}" target="_blank" rel="noopener">
                    {{ icon('ph:bold/arrow-square-out') }}
                </a>
            </div>
        {% endif %}
        <div class="modal-close">
            <a class="action-icon" href="#">
                {{ icon('ph:bold/x') }}
            </a>
        </div>
    </div>
    <div class="modal-loading">
        <div class="modal-loading-bar"></div>
    </div>
    {%- if export_navigation is defined and export_navigation -%}
        {{- block('page_navigation') -}}
    {%- endif -%}
    <div class="modal-body">
        {%- block page_composer_modal -%}
            {{ block('page_body') }}
        {%- endblock -%}
    </div>
{%- endblock -%}
