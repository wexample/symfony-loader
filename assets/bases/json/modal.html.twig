{%- extends '@WexampleSymfonyLoaderBundle/bases/json/default.html.twig' -%}

{%- block layout_composer_json -%}
    {%- set content -%}
        {{ parent() }}
    {%- endset -%}
    {%- block layout_composer_modal -%}
        {{ content }}
    {%- endblock -%}
{%- endblock -%}

{%- block page_composer_json -%}
    {%- include '@WexampleSymfonyLoaderBundle/bases/json/_overlay-shell-header.html.twig' with { overlay_type: 'modal' } -%}
    {%- if export_navigation is defined and export_navigation -%}
        {{- block('page_navigation') -}}
    {%- endif -%}
    {#- The body is the page's ground, as the zone a full page is drawn in: the
        same rhythm between what it holds, the same surface under it. -#}
    {#- Edge to edge when the page asks (`page_zone_flush`), as a page's zone
        and an embed are: an editor, a document viewer. -#}
    <div class="modal-body{{ page_zone_flush|default(false) ? ' modal-body--flush' }} stack--vertical" data-page-scroll>
        {%- block page_composer_modal -%}
            {#- A page that takes over its container rather than its body —
                a workspace laid out in regions — is drawn by its container. -#}
            {%- if block('page_body') is defined -%}
                {{ block('page_body') }}
            {%- elseif block('page_body_container') is defined -%}
                {{ block('page_body_container') }}
            {%- endif -%}
        {%- endblock -%}
    </div>
    {#- What the page does, below what it says: kept in view at the foot of the
        modal whatever the body scrolls. A page fills `page_actions` to have it. -#}
    {%- set pageActions %}{% block page_actions %}{% endblock %}{% endset -%}
    {%- if pageActions|trim is not empty -%}
        <div class="modal-actions page-actions">{{ pageActions }}</div>
    {%- endif -%}
{%- endblock -%}
