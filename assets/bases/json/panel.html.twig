{%- extends '@WexampleSymfonyLoaderBundle/bases/json/default.html.twig' -%}

{%- block layout_composer_json -%}
    {%- set content -%}
        {{ parent() }}
    {%- endset -%}
    {%- block layout_composer_panel -%}
        {{ content }}
    {%- endblock -%}
{%- endblock -%}

{%- block page_composer_json -%}
    {%- include '@WexampleSymfonyLoaderBundle/bases/json/_overlay-shell-header.html.twig' with { overlay_type: 'panel' } -%}
    {%- if export_navigation is defined and export_navigation -%}
        {{- block('page_navigation') -}}
    {%- endif -%}
    <div class="panel-body">
        {%- block page_composer_panel -%}
            {{ block('page_body') }}
        {%- endblock -%}
    </div>
    {#- What the page does, below what it says: kept in view at the foot of the
        panel whatever the body scrolls. A page fills `page_actions` to have it. -#}
    {%- set pageActions %}{% block page_actions %}{% endblock %}{% endset -%}
    {%- if pageActions|trim is not empty -%}
        <div class="panel-actions page-actions">{{ pageActions }}</div>
    {%- endif -%}
{%- endblock -%}
