<div class="{{ overlay_type }}-header">
    {% set page_title = page_title | default('@page::page_title' | trans) %}
    {% if page_title | default(false) %}
        <h2 class="header-title">{{ page_title | trans }}</h2>
    {% else %}
        <div class="header-title"></div>
    {% endif %}
    {% if overlay_show_external_link is not defined or overlay_show_external_link != false %}
        <div class="{{ overlay_type }}-external-link">
            <a class="action-icon" href="{{ app.request.uri }}" target="_blank" rel="noopener">
                {{ icon('ph:bold/arrow-square-out') }}
            </a>
        </div>
    {% endif %}
    <div class="{{ overlay_type }}-close">
        <a class="action-icon" href="#">
            {{ icon('ph:bold/x') }}
        </a>
    </div>
</div>
<div class="{{ overlay_type }}-loading">
    <div class="{{ overlay_type }}-loading-bar"></div>
</div>
