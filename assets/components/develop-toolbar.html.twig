<div class="develop-toolbar">
    <div class="develop-toolbar__resize-handle"></div>
    <div class="tabs develop-toolbar__tabs-bar">
        <a class="tabs--item tabs--item--active" href="#" data-tab="assets">
            <span class="tabs--item-content">
                <span class="tabs--item-label">{{ '@component::tab.assets' | trans }}</span>
            </span>
        </a>
        <a class="tabs--item" href="#" data-tab="ssr">
            <span class="tabs--item-content">
                <span class="tabs--item-label">{{ '@component::tab.ssr' | trans }}</span>
            </span>
        </a>
        <a class="tabs--item" href="#" data-tab="responsive">
            <span class="tabs--item-content">
                <span class="tabs--item-label">{{ '@component::tab.responsive' | trans }}</span>
            </span>
        </a>
        <a class="tabs--item" href="#" data-tab="nodes">
            <span class="tabs--item-content">
                <span class="tabs--item-label">{{ '@component::tab.nodes' | trans }}</span>
            </span>
        </a>
        <button class="develop-toolbar__symfony-toggle" data-symfony-toolbar-toggle title="{{ '@component::symfony' | trans }}">
            {{ icon('ph:bold/function') }}
        </button>
        <button class="develop-toolbar__close" data-develop-toolbar-toggle="1" title="{{ '@component::close' | trans }}">
            {{ icon('ph:bold/x') }}
        </button>
    </div>
    <div class="develop-toolbar__panel">
        <div class="develop-toolbar__mount" data-tab-panel="assets">
            {{ vue_include(render_pass, '@WexampleSymfonyLoaderBundle/vue/debug-assets') }}
        </div>
        <div class="develop-toolbar__mount develop-toolbar__mount--hidden" data-tab-panel="ssr">
            {{ vue_include(render_pass, '@WexampleSymfonyLoaderBundle/vue/develop-ssr') }}
        </div>
        <div class="develop-toolbar__mount develop-toolbar__mount--hidden" data-tab-panel="responsive">
            {{ vue_include(render_pass, '@WexampleSymfonyLoaderBundle/vue/develop-responsive') }}
        </div>
        <div class="develop-toolbar__mount develop-toolbar__mount--hidden" data-tab-panel="nodes">
        </div>
    </div>
</div>
